{"nodes": [{"id": "bauplan", "label": "BAUPLAN.md (Bauplan fuer eine Gameshow)", "file_type": "document", "source_file": "BAUPLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Regel hat einen Anlass (Fehler mit Commit-Hash), nichts davon ist Geschmack."}, {"id": "bauplan_zero_build", "label": "Zero Build (klassische script-Tags, kein Bundler)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deploy ist ein git push - nichts dazwischen, was waehrend einer laufenden Show scheitern koennte."}, {"id": "bauplan_drei_clients_ein_zustand", "label": "Drei Clients, ein Zustand (Host, Mainscreen, Handys ueber Firebase RTDB)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_dom_diffing_morphmirror", "label": "DOM-Diffing statt Re-Rendering (morphMirror)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "0, 4.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "innerHTML-Austausch liess bei jedem Punktestand laufende Videos und Animationen auf der Leinwand neu anfangen."}, {"id": "bauplan_mutationobserver_spiegelung", "label": "MutationObserver-Spiegelung ins Zuschauerfenster (startBoardMirror, scheduleBoardMirror)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zuschauerfenster hat keine eigene Logik; Beobachter auf dem Haupt-body, gebuendelt per requestAnimationFrame."}, {"id": "bauplan_dreistufige_buzzer_degradation", "label": "Dreistufige Buzzer-Degradation (firebase / sse / none)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_proxy_rpc", "label": "Proxy-basierter RPC (vorgetaeuschtes window.opener auf dem Gamepad)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dasselbe GM-Markup laeuft im eingebetteten Panel und auf dem Handy ohne Unterschied; opener.xxx() wandert ueber Firebase zum Host."}, {"id": "bauplan_allowlist_befehlsausfuehrung", "label": "Allowlist-gesicherte Befehlsausfuehrung (GM_REMOTE_ALLOWED_FNS, fail-closed)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0, 2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fernaufrufe nicht ueber window[name](), sondern gegen Allowlist und typeof function geprueft."}, {"id": "bauplan_optimistic_ui", "label": "Optimistic UI Updates (assignPlayerTeam)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne Verbindung kaeme die Antwort nie, der Knopf saehe aus, als haette er nicht reagiert."}, {"id": "bauplan_optimistic_concurrency", "label": "Optimistic Concurrency per Firebase-transaction (tpspin/by)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0, 3.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zwei gleichzeitige Finger ergeben einen Dreh, nicht zwei."}, {"id": "bauplan_logische_uhr_nextroundid", "label": "Monoton steigende Rundennummer (nextRoundId = max(Date.now(), prev+1))", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "0, 3.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Zaehler ab 0 fing nach Host-Reload von vorn an; Handys mit derselben Nummer behielten ihre Sperre."}, {"id": "bauplan_board_public_screens", "label": "BOARD_PUBLIC_SCREENS-Allowlist (Bildschirm gehoert dem Publikum)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "0, 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frueher Denylist; sie hinkte jeder neuen Show hinterher, zuletzt stand der Intro-Editor auf der Leinwand (66616c9). Host-Knoepfe nie auf dem Spiel-Screen (1673e6d)."}, {"id": "bauplan_gradual_typing_jsdoc", "label": "Gradual Typing ueber JSDoc (checkJs, noEmit)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0, 3.10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pruefung meldet nichts - deshalb gehoert eine neue Meldung zur gerade gemachten Aenderung."}, {"id": "bauplan_presence_ondisconnect", "label": "Presence mit onDisconnect().remove()", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_nicht_vorhanden", "label": "Was hier NICHT steckt (keine Tests, keine CI-Pruefung, kein Server, PIN-Hash ohne Salt, Host-Passwort im JS)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wer das Gegenteil annimmt, baut auf Sand. PINs: SHA-256 ueber 'keller:'+name+':'+pin, kein Key-Stretching; HOST_PASSWORD ist Vorhang, kein Schloss."}, {"id": "bauplan_sieben_fragen", "label": "Die sieben Fragen vor der ersten Zeile", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Teams/Teilnehmer, Buzzern, Tippen, Publikum vs Host, Zug (phase), Ende, Wertung - entscheiden ueber die halbe Architektur."}, {"id": "bauplan_spieldatei_skelett", "label": "Skelett der Spieldatei js/xxx.js (12 Abschnitte in fester Reihenfolge)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_start_fuenf_schritte", "label": "Start in fuenf Schritten (pruefen, Popout, Reset inkl. Undo, Buzzer-Kontext, Intro)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pruefung vor dem Popout: ein abgebrochener Start soll kein leeres Fenster aufmachen."}, {"id": "bauplan_intro_lauf", "label": "Wortgleicher Intro-Lauf xxxIntroThenGame (Intro, Zeichen, Anleitung, Titel)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_elf_anmeldungen", "label": "Die elf Anmeldungen einer Show", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vergessene Anmeldungen sind der haeufigste Fehler; check.js findet nur die ersten zwei. Turnier: zusaetzlich TOURNAMENT_GAMES, TOURNAMENT_AUTO_RESULT, TOURNAMENT_DEFAULT_WEIGHTS, tournamentGameIcon, option."}, {"id": "bauplan_gm_panel_schnitt", "label": "GM-Panel-Schnitt (xxxGmControlsHtml(pfx) + updateGamemasterXxx)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pfx = 'opener.' im GM-Fenster, '' im Hauptfenster; Gamepad spiegelt genau dieses Dokument."}, {"id": "bauplan_dom_helfer", "label": "Nie roh ans DOM: Helfer fieldVal/setText/setHtml/showEl/screenActive/setClass", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getElementById(x).value wirft bei Tippfehler; rund 250 Stellen abgeloest. Ein fehlender Knopf darf keine Show abbrechen. showEl mit '' statt 'block'."}, {"id": "bauplan_escapen_pflicht", "label": "Escapen ist Pflicht (escapeHtml, escAttr, escJsArg)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spieler O'Brien: assignPlayerTeam('o'brien',0) tat wortlos nichts; escJsArg serialisiert per JSON.stringify."}, {"id": "bauplan_inline_handler_strings", "label": "Inline-Handler sind Zeichenketten (~400, kein Werkzeug sieht sie)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Umbenennung mit uebersehener Zeichenkette faellt erst auf, wenn waehrend der Show jemand drueckt - daher check.js vor jedem Commit."}, {"id": "bauplan_wache_vor_wirkung", "label": "Zustand: Wache vor Wirkung (undo.save hinter die Wache, Phasenpruefung, Reset beim Start)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aus Fehlern in js/tp.js (1db72e0): No-op-Undo-Eintraege, doppelt weiterspringender Zug, Undo holte das vorige Spiel."}, {"id": "bauplan_anzeige_folgt_zustand", "label": "Anzeige folgt dem Zustand ueberall (updateGamemaster bei jedem Wechsel)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PIH-Gebotszaehler stand im GM auf 0/6, waehrend auf der Leinwand alle da waren (66616c9)."}, {"id": "bauplan_handy_kanaele", "label": "Handy-Kanaele: Rundennummer, gezielt hoeren, null statt {}, transaction, nur Verweise", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "/buzzer enthaelt players mit PIN-Hashes; excluded:{} schreibt Firebase nicht; Turnier merkt Dateinamen statt mehrere MB Board."}, {"id": "bauplan_timer_sperre", "label": "Timer, die eine Sperre zeichnen, zeichnen einmal mehr", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Im Takt des Ablaufs wurde nicht mehr gezeichnet; Buzz-Knopf blieb deaktiviert (1db72e0)."}, {"id": "bauplan_relativ_rechnen", "label": "Relativ rechnen, nicht gegen null (TP-Rad-Winkel)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zielwinkel als stuende das Rad auf 0; ab dem zweiten Dreh summierte sich der Versatz und das Rad zeigte eine andere Kategorie."}, {"id": "bauplan_eine_quelle_eine_funktion", "label": "Eine Quelle, eine Funktion (contextTeamNames, playerTeamButtonsHtml, readJsonFile)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "3.9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drei Fassungen von Teamnamen/Team-Knoepfen: Team-3-Spieler fielen aus jeder Wertung (66616c9). Eigene FileReader ohne BOM-Behandlung (a3fd47c)."}, {"id": "bauplan_lesbarkeit_bedienbarkeit", "label": "Lesbar aus drei Metern, bedienbar im Halbdunkel (>=12px, Klickflaeche >=32px)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "4.2, 4.3, 4.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Host bedient einhaendig im Dunkeln; mittig bei verschieden langen Zeilen, gleich breite Spalten, Angeschnittenes sieht kaputt aus."}, {"id": "bauplan_knopf_hierarchie_teamfarben", "label": "Nur ein lautester Knopf je Flaeche; feste Teamfarben (#E8453C, #3B82F6, #22C55E)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "4.4, 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Teams zuteilen' war lauter als 'Spiel starten' (f14dd4c). Gruenes '0' versprach Verbundene, die es nicht gab."}, {"id": "bauplan_css_statt_gsap", "label": "Was das Publikum sieht, animiert CSS - nicht JavaScript/GSAP", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "4.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mainscreen spiegelt nur DOM: GSAP schreibt je Frame style und steht bei gedrosseltem Hauptfenster still; Canvas/WebGL kommt gar nicht an. Taktung als CSS-Variablen (--d, --dur, --st, --i)."}, {"id": "bauplan_abnahme_liste", "label": "Abnahme-Liste (ganze Show im Browser durchspielen)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bauplan_firebase_stub", "label": "Firebase-Ersatz beim Testen (fbstub.js per context.route, __fbWrites)", "file_type": "rationale", "source_file": "BAUPLAN.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lokale Tests schrieben in die Live-DB (buzzer/joinLocked stand live auf true). Seit 431a43e schreibt designPushToPhones schon beim load - Stummschalten nach dem Laden reicht nicht."}, {"id": "bauplan_screenshot_pruefung", "label": "Screenshot-Pruefung tools/shots (18 Richtungen + Studio-Blau)", "file_type": "concept", "source_file": "BAUPLAN.md", "source_location": "5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Befunde: JS-Fehler, Richtung nicht angekommen, Screen hoeher als 1280x720 (Groesse des Beamer-Popouts)."}, {"id": "bauplan_drei_testregeln", "label": "Drei Regeln fuer den Test selbst (waere er rot geworden?, Wege des