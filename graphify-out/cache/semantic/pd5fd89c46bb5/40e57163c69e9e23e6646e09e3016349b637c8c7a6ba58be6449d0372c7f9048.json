{"nodes": [{"id": "buzzer_index", "label": "buzzer/index.html (Keller Buzzer, Handy-Seite)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eigenstaendige Handy-Seite: Login/Account, Lobby, Buzzer, Schaetzfrage, Rad drehen (TP), Abstimmung (DDF). Liest Design-Richtung aus Firebase und setzt sie mit js/theme.js."}, {"id": "buzzer_index_firebase_keller_buzzer", "label": "Firebase-Projekt keller-buzzer (RTDB-Config)", "file_type": "concept", "source_file": "buzzer/index.html", "source_location": "L430", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gleiche firebaseConfig steht in buzzer, gamepad, voting/index und voting/ergebnis; Regeln sind offen beschreibbar, deshalb werden Werte aus Firebase gefiltert (safeColor, themeByKey)."}, {"id": "buzzer_index_dologin", "label": "doLogin()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L502", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_createaccount", "label": "createAccount()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L527", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_loginas", "label": "loginAs()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L539", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_hashpin", "label": "hashPin()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L474", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHA-256 ueber keller:<key>:<pin>; nur der Hash liegt in buzzer/players."}, {"id": "buzzer_index_keyof", "label": "keyOf() (Buzzer)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L473", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_safecolor", "label": "safeColor()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L462", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Farben kommen aus offen beschreibbarem Firebase; nur #hex wird durchgelassen, weil sie in style-Attributen landen."}, {"id": "buzzer_index_buzz_gradients", "label": "BUZZ_GRADIENTS / applyBuzzColor() (Teamfarbe am Buzzer)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L454", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fuellung des Buzzers bleibt die Teamfarbe (BAUPLAN 4.4), ohne Team neutrales Gold statt Team-Rot."}, {"id": "buzzer_index_theme_buzz_styles", "label": "Buzzer-Form je Design-Richtung (CSS data-theme A-S)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L192", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Richtung bestimmt Form, Rand und Schrift des Knopfes nach den Entwuerfen designs/s/<K>-Handy.html, nicht seine Farbe."}, {"id": "buzzer_index_design_listener", "label": "Design-Richtung-Listener (db.ref design, Buzzer)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L446", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_refreshroot", "label": "refreshRoot()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L753", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen-Prioritaet: gesperrt > Abstimmung > Schaetzfrage > Rad drehen > Buzzer > Lobby."}, {"id": "buzzer_index_refreshbuzz", "label": "refreshBuzz()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L777", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ohne Verbindung wird der Knopf gesperrt statt bunt gelassen; Zustand haengt als Klasse am Knopf, weil das Handy oft auf dem Tisch liegt."}, {"id": "buzzer_index_everactive", "label": "everActive / markActive() / clearActive()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L611", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trennt Show noch nicht begonnen (Lobby) von naechste Frage kommt gleich (Buzzer bleibt). In sessionStorage, damit es ein Neuladen ueberlebt; zurueckgesetzt beim Loesen von joinLocked."}, {"id": "buzzer_index_buzz_pointerdown", "label": "Buzz-Handler (pointerdown)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L807", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pointerdown statt click, weil click erst beim Loslassen feuert; Reihenfolge entscheidet der Server-Zeitstempel. Fehlstart sperrt 3 s."}, {"id": "buzzer_index_buzzer_tree_listeners", "label": "Gezielte Listener auf buzzer/live, armed, round, buzzes, excluded", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L826", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein Sammel-Listener auf /buzzer: er wuerde alle Accounts samt PIN-Hashes auf jedes Handy laden und bei jeder fremden Aenderung feuern."}, {"id": "buzzer_index_recomputeresults", "label": "recomputeResults()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L833", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_lock_ticker", "label": "Sperr-Takt (setInterval 250 ms)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1038", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zeichnet weiter, solange eine Sperre eingetragen ist, und raeumt sie selbst weg; vorher blieb der Buzzer nach einem Fehlstart deaktiviert haengen."}, {"id": "buzzer_index_showestimate", "label": "showEstimate()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L679", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_sendestimate", "label": "sendEstimate()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1000", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_parseestimate", "label": "parseEstimate()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L990", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Versteht deutsche Schreibweise (390.000 = dreihundertneunzigtausend); null fuer Nicht-Zahlen, die der Host hinten anhaengt."}, {"id": "buzzer_index_setclass", "label": "setClass() (lokale Kopie)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L711", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_showtpspin", "label": "showTpSpin()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L910", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_sendspin", "label": "sendSpin()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L923", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "transaction auf buzzer/tpspin/by statt set: zwei gleichzeitige Finger ergeben genau einen Dreh."}, {"id": "buzzer_index_rendervote", "label": "renderVote() (DDF-Abstimmung)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L956", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_sendvote", "label": "sendVote()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L977", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_showlobby", "label": "showLobby()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L730", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_pickrandomlobbygif", "label": "pickRandomLobbyGif()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L657", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einmal beim Login gewuerfelt, nicht in refreshRoot, sonst blitzen bei den vielen Login-Listenern mehrere GIFs auf."}, {"id": "buzzer_index_setconnbanner", "label": "setConnBanner() (Buzzer)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1071", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2,5 s Schonfrist beim Start, sonst blitzt bei jedem Laden eine Fehlermeldung auf."}, {"id": "buzzer_index_keepawake", "label": "keepAwake() (Buzzer, Wake Lock)", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_registerpresence", "label": "registerPresence() / startPresence()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1117", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "buzzer_index_subscribeaccount", "label": "subscribeAccount()", "file_type": "code", "source_file": "buzzer/index.html", "source_location": "L1125", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "buzzer_index", "target": "js_theme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "buzz