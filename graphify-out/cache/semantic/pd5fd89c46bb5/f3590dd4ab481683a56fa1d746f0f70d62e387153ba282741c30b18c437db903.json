{"nodes": [{"id": "designs_s_direction_new_york", "label": "Design-Richtung New York (Zeitung)", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jede Show als Zeitungsseite: Fraktur-Kopf \"The Iryo Gameshow\" (UnifrakturMaguntia), Old Standard TT + Playfair Display, Papier #E2D8C0 mit SVG-Rauschen, Tinte #1A1712, Doppellinien. Jede Show bekommt ein Ressort mit Seitenzahl (Unterhaltung S.2, Umfrage S.3, Raetselecke S.4, Geschichte S.5, Wissen S.7, Gesellschaft S.9, Kleinanzeigen S.11, Sport S.14)."}, {"id": "designs_s_screen_ddf", "label": "Entwurfs-Screen: Der D\u00fcmmste fliegt", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designs_s_newspaper_section_metaphor", "label": "Zeitungsressort-Metapher je Show", "file_type": "rationale", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spielmechanik wird in Zeitungsformate uebersetzt: Umfragegrafik (Feud), Raster mit geschwaerzten Feldern fuer geloeste Fragen (Jeopardy), Kleinanzeigen/Gebote (PIH), Stimmzettel (WWDS), Sporttabelle (Turnier), Portraets mit AUSGESCHIEDEN-Stempel (DDF), Ankreuzfeld + Gewinnstufen-Spalte (WWM), Abbildung \"Das Rad\" (TP)."}, {"id": "designs_s_paper_texture_svg_noise", "label": "Papiertextur per SVG feTurbulence", "file_type": "rationale", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Papierkorn, Mottle und Knitterlicht als Inline-SVG-Filter (feTurbulence, feDiffuseLighting) bzw. data:-URI im background-image, multiply-geblendet - keine Bilddateien noetig."}, {"id": "designs_s_team_colors", "label": "Teamfarben Rot #E8453C / Blau #3B82F6 / Gruen #22C55E", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designs_s_mock_scenario", "label": "Gemeinsames Beispielszenario (Keller-Abend)", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alle Entwuerfe nutzen dieselben Daten: Spieler Anna, Ben, Clara (Rot), Emil, Fiona, Gustav (Blau), Gast Hanna; Stichwort KELLER; Feud-Frage Partykeller (Bierkasten 31, Musikbox 22, Altes Sofa 11); Stand Rot 120 / Blau 85; PIH Kaffeevollautomat 429 EUR; WWM Frage 8 Wales-Flagge; Turnier Rot 16 / Blau 12 / Gruen 6."}, {"id": "designs_s_fixed_canvas_1280x720", "label": "Feste Entwurfsflaeche 1280x720 (Handy 390x844)", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designs_s_ny_eliminated_stamp", "label": "AUSGESCHIEDEN-Stempel (DDF New York)", "file_type": "concept", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designs_s_l_ddf", "label": "New York \u00b7 Der D\u00fcmmste fliegt (L-DDF.html)", "file_type": "document", "source_file": "designs/s/L-DDF.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "designs_s_l_ddf", "target": "designs_s_direction_new_york", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "designs/s/L-DDF.html", "source_location": null, "weight": 1}, {"source": "designs_s_l_ddf", "target": "designs_s_screen_ddf", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "designs/s/L-DDF.html", "source_loc